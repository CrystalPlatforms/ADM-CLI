{
  "name": "@crystalplatforms/adm",
  "version": "0.3.0",
  "description": "ADM — lightweight, multi-platform developer environment installer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CrystalPlatforms/ADM-CLI.git"
  },
  "homepage": "https://github.com/CrystalPlatforms/ADM-CLI#readme",
  "bugs": {
    "url": "https://github.com/CrystalPlatforms/ADM-CLI/issues"
  },
  "bin": {
    "adm": "bin/adm"
  },
  "files": [
    "bin/",
    "src/",
    "scripts/completion/",
    "scripts/install.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node ./bin/adm",
    "test": "jest --config=jest.config.js",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "cli",
    "developer-tools",
    "setup",
    "dotfiles",
    "adm"
  ],
  "dependencies": {
    "chalk": "^4.1.2",
    "inquirer": "^8.2.6",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "jest": "^30.5.2"
  }
}
